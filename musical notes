        string title;           // Title of the project (e.g., song name)
        address artist;         // Address of the artist
        uint256 legalFund;      // Legal fund balance for the project
        address[] stakeholders; // Stakeholders involved in revenue split
        uint256[] shares;       // Percentage shares for revenue distribution
    }

    mapping(uint256 => Project) public projectLedger; // Ledger of all projects

    constructor() ERC721("Music Notes Token", "MNOTE") {}

