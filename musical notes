pragma solidity ^0.8.20;

/// @title Music Notes Revenue Split
/// @notice Automatically splits music revenue

contract MusicNotesRevenue {

    address public artist;
    address public platform;

    uint256 public constant ARTIST_SHARE = 75;
    uint256 public constant PLATFORM_SHARE = 25;

    event RevenueReceived(uint256 amount);
    event RevenuePaid(address artist, uint256 artistAmount, uint256 platformAmount);

    constructor(address _artist, address _platform) {
        artist = _artist;
        platform = _platform;
    }

    receive() external payable {
        _distribute(msg.value);
    }

    function _distribute(uint256 amount) internal {
        uint256 artistAmount = (amount * ARTIST_SHARE) / 100;
        uint256 platformAmount = amount - artistAmount;

        payable(artist).transfer(artistAmount);
        payable(platform).transfer(platformAmount);

        emit RevenuePaid(artist, artistAmount, platformAmount);
    }
}


