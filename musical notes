    function mintSongNFT(
        address artist,
        string calldata metadataURI,
        string memory title,
        address[] memory stakeholders,
        uint256[] memory shares
    ) external onlyOwner {
        require(stakeholders.length == shares.length, "Stakeholders and shares mismatch");

        uint256 tokenId = nextTokenId;
