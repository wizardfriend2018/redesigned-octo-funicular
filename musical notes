        _tokenURIs[tokenId] = metadataURI; // Add metadata to the token

        // Add project details to the ledger
        projectLedger[tokenId] = Project({
            title: title,
            artist: artist,
            legalFund: 0, // Initial legal fund balance
            stakeholders: stakeholders,
            shares: shares
        });
    }

    // Override tokenURI to return metadata
